---
import Layout from '../layouts/Layout.astro';
import FollowMe from '../components/FollowMe.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import MediaRotator from '../components/MediaRotator.astro';
import CtaBand from '../components/CtaBand.astro';
import { BRAND, BASE_GYM, SERVICES, SOCIALS, TRAINER, WHATSAPP_NUMBER } from '../config';
import { withBase } from '../utils/paths';

const sameAs = Object.values(SOCIALS).filter(Boolean);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  name: BRAND,
  description: `Personal trainer in central London. Training at ${BASE_GYM} and home visits across London.`,
  telephone: `+${WHATSAPP_NUMBER}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'London',
    addressCountry: 'GB',
  },
  areaServed: [
    { '@type': 'Place', name: 'Central London' },
    { '@type': 'City', name: 'London' },
  ],
  founder: { '@type': 'Person', name: TRAINER, jobTitle: 'Personal Trainer' },
  makesOffer: SERVICES.map((s) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: `${s.name} personal training` },
  })),
  ...(sameAs.length ? { sameAs } : {}),
};
---

<Layout
  title={`Personal Trainer Central London | ${BRAND}`}
  description={`Personal trainer in central London at ${BASE_GYM}, with home visits anywhere in London. Strength & conditioning, calisthenics, weight loss, body recomposition, mobility and rehab. Book an intro session on WhatsApp.`}
  schema={schema}
>
  <!-- Hero: full-bleed rotating media with the headline over it -->
  <section class="hero on-dark">
    <MediaRotator />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container hero-content">
      <div class="hero-follow">
        <FollowMe />
      </div>
      <p class="eyebrow">Train like an athlete</p>
      <h1>Personal trainer <span class="accent">in central London</span></h1>
      <p class="lead">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut
        labore et dolore magna aliqua.
      </p>
      <div class="hero-actions">
        <WhatsAppButton />
        <a class="btn btn--ghost" href={withBase('/services/')}>Services</a>
      </div>
    </div>
  </section>

  <!-- Where -->
  <section class="section">
    <div class="container where">
      <h2>Where I train clients</h2>
      <div class="where-list">
        <div>
          <p class="eyebrow">Gym</p>
          <h3>{BASE_GYM}</h3>
          <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt.</p>
        </div>
        <div>
          <p class="eyebrow">Home visits</p>
          <h3>Anywhere in London</h3>
          <p>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container">
      <div class="services-head">
        <h2>Services</h2>
        <a class="text-link" href={withBase('/services/')}>All services <span aria-hidden="true">→</span></a>
      </div>
      <ul class="services-list">
        {
          SERVICES.map((s) => (
            <li>
              <a href={`${withBase('/services/')}#${s.slug}`}>
                <span class="name">{s.name}</span>
                <span class="short">{s.short}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(34rem, 100svh, 58rem);
    background: var(--black);
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: clamp(4.5rem, 9vw, 6.5rem);
    overflow: hidden;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(5, 5, 6, 0.96) 0%,
      rgba(5, 5, 6, 0.75) 38%,
      rgba(5, 5, 6, 0.15) 75%,
      rgba(5, 5, 6, 0.35) 100%
    );
  }
  .hero-content {
    position: relative;
    z-index: 2;
  }
  .hero h1 {
    max-width: 11ch;
  }
  .hero-follow {
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  @media (max-width: 520px) {
    .hero-actions :global(.btn) {
      flex: 1 1 100%;
    }
  }

  .where {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 860px) {
    .where {
      grid-template-columns: 1fr 2fr;
      gap: 4rem;
    }
  }
  .where h2 {
    margin: 0;
  }
  .where-list {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 640px) {
    .where-list {
      grid-template-columns: 1fr 1fr;
    }
  }
  .where-list > div {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .where-list h3 {
    margin-bottom: 0.75rem;
  }
  .where-list p:last-child {
    margin: 0;
  }

  .services-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .services-head h2 {
    margin: 0;
  }
  .services-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .services-list a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.35rem 1.5rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .services-list .name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.7rem, 6vw, 2.6rem);
    text-transform: uppercase;
    line-height: 1;
    transition: color 0.25s;
  }
  .services-list .short {
    grid-column: 1;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .services-list .arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-size: 1.4rem;
    color: var(--muted);
    transition:
      color 0.25s,
      transform 0.25s;
  }
  .services-list a:hover .name,
  .services-list a:hover .arrow {
    color: var(--accent);
  }
  .services-list a:hover .arrow {
    transform: translateX(4px);
  }
  @media (min-width: 860px) {
    .services-list a {
      grid-template-columns: 1fr 1fr auto;
      padding: 1.75rem 0;
    }
    .services-list .short {
      grid-column: 2;
    }
    .services-list .arrow {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
