---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ImageSlot from '../components/ImageSlot.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import { BRAND, BASE_AREA, GYM_ADDRESS, SERVICES, SOCIALS, STATIONS, TRAINER, WHATSAPP_NUMBER } from '../config';
import { withBase } from '../utils/paths';

const sameAs = Object.values(SOCIALS).filter(Boolean);
const addressParts = GYM_ADDRESS.match(/^(.*?)(?:\s+)([A-Z]{1,2}\d[A-Z\d]?\s?\d[A-Z]{2})$/i);

const gymMapUrl = `https://www.google.com/maps?q=${encodeURIComponent(GYM_ADDRESS)}&output=embed`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(GYM_ADDRESS)}`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  name: BRAND,
  description: `Personal trainer in central London. Gym sessions in ${BASE_AREA} and private in-home personal training across central London.`,
  telephone: `+${WHATSAPP_NUMBER}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'London',
    addressCountry: 'GB',
  },
  areaServed: [
    { '@type': 'Place', name: 'Central London' },
    { '@type': 'City', name: 'London' },
  ],
  founder: { '@type': 'Person', name: TRAINER, jobTitle: 'Personal Trainer' },
  makesOffer: SERVICES.map((s) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: `${s.name} personal training` },
  })),
  ...(sameAs.length ? { sameAs } : {}),
};
---

<Layout
  title={`Personal Trainer Central London | ${BRAND}`}
  description={`Personal trainer in central London, ${BASE_AREA} based, with private in-home personal training across central London. Strength & conditioning, calisthenics, body recomposition, mobility and rehab. Book a session on WhatsApp or by enquiry.`}
  schema={schema}
>
  <!-- Hero: one looping clip behind the headline, set along the bottom -->
  <section class="hero on-dark">
    <div class="hero-media" aria-hidden="true">
      <video src={withBase('/media/about_me_montage.mp4')} autoplay muted loop playsinline preload="auto"></video>
    </div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container narrow hero-content">
      <p class="hero-eyebrow" data-reveal style="--d: 0">
        Personal training in central London
      </p>
      <h1 class="hero-title">
        <span class="line" data-reveal style="--d: 1">Train like an</span>
        <span class="line accent" data-reveal style="--d: 2"><em>athlete.</em></span>
      </h1>

      <div class="hero-foot" data-reveal style="--d: 3">
        <div class="actions">
          <WhatsAppButton />
          <a class="btn btn--ghost hero-services" href={withBase('/services/')}>Services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services ticker: runs straight under the hero -->
  <section class="services-ticker-section on-dark" aria-label="Training services">
    <p class="visually-hidden">
      Strength &amp; conditioning, Sport-specific training, Calisthenics, Body recomposition, Mobility &amp; flexibility, Rehabilitation.
    </p>
    <a class="ticker-strip" href={withBase('/services/')} aria-label="View all services">
      <div class="ticker-viewport">
        <div class="ticker-track">
          {[0, 1].map(() => (
            <div class="ticker-group" aria-hidden="true">
              {SERVICES.map((service) => (
                <span class="ticker-item">{service.name}<span class="ticker-dot" aria-hidden="true"></span></span>
              ))}
            </div>
          ))}
        </div>
      </div>
    </a>
  </section>

  <!-- Where I train clients: centred heading and line, a rule under, then the two places side by side -->
  <section class="section where-section">
    <div class="container">
      <div class="where-head" data-reveal>
        <h2>Where I train clients</h2>
        <p>The gym in {BASE_AREA}, or your own home. Whichever fits your week.</p>
      </div>
      <div class="where">
        <article class="place">
          <div class="place-media">
            <ImageSlot
              label={`Training in ${BASE_AREA}`}
              src="/media/gym-session.mp4"
              type="video"
              ratio="3 / 2"
            />
            <p class="place-bar">Gym sessions</p>
          </div>
          <div class="place-text" data-reveal>
            <h3>{BASE_AREA} based</h3>
            <p>One-to-one sessions in a fully kitted-out gym in central London. Rigs, bars, rings and free weights, everything we need.</p>
          </div>
        </article>
        <article class="place">
          <div class="place-media">
            <ImageSlot label="A private in-home session" ratio="3 / 2" delay={1} />
            <p class="place-bar">Across central London</p>
          </div>
          <div class="place-text" data-reveal style="--d: 1">
            <h3>Private in-home personal training</h3>
            <p>No time to get to the gym? I'll come to you. Hardly any kit needed, and you won't waste time commuting.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <GoogleReviews />

  <!-- Booking: WhatsApp first, the email enquiry on its own /book/ page -->
  <section class="section on-dark book-section" id="book">
    <div class="container narrow book">
      <div class="book-intro">
        <h2>Book a session</h2>
        <p>Tell me your goals and we’ll find a training plan that works for you.</p>
      </div>
      <!-- Buttons, then the email link under them: all centred -->
      <div class="book-actions">
        <div class="actions">
          <WhatsAppButton label="Message me" />
          <a class="btn btn--ghost" href={withBase('/services/')}>See what I offer</a>
        </div>
        <p class="email-prompt">Prefer email? <a class="email-link" href={withBase('/book/')}>Send an enquiry</a></p>
      </div>
    </div>
  </section>
  <section class="section location-sections" aria-label="Location and contact">
    <!-- Find me and Get in touch stacked on the left, the map on the right -->
    <div class="container location-grid">
      <div class="location-copy">
        <section class="location-block find-block" aria-labelledby="find-heading">
          <h2 id="find-heading">Find me</h2>
          <div class="address-panel">
            <address>
              {addressParts ? <><span>{addressParts[1]}</span><span>{addressParts[2]}</span></> : GYM_ADDRESS}
            </address>
          </div>
          <ul class="stations" aria-label="Nearest stations">
            {
              STATIONS.map((st) => (
                <li>
                  <span class="station-name">{st.name}</span>
                  <span class="station-walk">{st.walk}</span>
                </li>
              ))
            }
          </ul>
          <a class="btn btn--ghost location-action" href={directionsUrl} target="_blank" rel="noopener">Get directions</a>
        </section>

        <section class="location-block contact-block" aria-labelledby="contact-heading">
          <h2 id="contact-heading">Get in touch</h2>
          <div class="location-follow">
            <ul>
              <li>
                {SOCIALS.instagram ? (
                  <a href={SOCIALS.instagram} target="_blank" rel="noopener"><span class="social-icon"><Icon name="instagram" /></span>Instagram</a>
                ) : (
                  <span><span class="social-icon"><Icon name="instagram" /></span>Instagram</span>
                )}
              </li>
              <li>
                {SOCIALS.tiktok ? (
                  <a href={SOCIALS.tiktok} target="_blank" rel="noopener"><span class="social-icon"><Icon name="tiktok" /></span>TikTok</a>
                ) : (
                  <span><span class="social-icon"><Icon name="tiktok" /></span>TikTok</span>
                )}
              </li>
            </ul>
          </div>
          <WhatsAppButton class="location-action" variant="ghost" label="Message me" icon={false} />
        </section>
      </div>
      <div class="map-frame">
        <iframe
          class="location-map"
          src={gymMapUrl}
          title={`Map showing where I train in ${BASE_AREA}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Hero clip: with reduced motion it stays on its first frame.
  const heroVideo = document.querySelector<HTMLVideoElement>('.hero-media video');
  if (heroVideo && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    heroVideo.removeAttribute('autoplay');
    heroVideo.pause();
  }

</script>


<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(34rem, 84svh, 52rem);
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
    overflow: hidden;
  }
  /* One looping clip behind the headline, darkened so the white type stays readable */
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(11, 11, 11, 0.88) 0%,
      rgba(11, 11, 11, 0.5) 55%,
      rgba(11, 11, 11, 0.6) 100%
    );
  }
  .hero-content {
    position: relative;
    z-index: 2;
    text-align: left;
  }
  .hero :global(.btn--primary.btn--whatsapp) {
    border-color: var(--accent);
    background: var(--accent);
    color: #fff;
  }
  .hero :global(.btn--primary.btn--whatsapp:hover),
  .hero :global(.btn--primary.btn--whatsapp:focus-visible) {
    border-color: #d46a3b;
    background: #d46a3b;
    color: #fff;
  }
  .hero-eyebrow {
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 16px;
    position: relative;
    left: -0.75rem;
    top: 3px;
  }
  /* iPhone: smaller, and lined up with the heading instead of pulled out toward the edge */
  @media (max-width: 520px) {
    .hero-eyebrow {
      left: 0;
      margin-bottom: 12px;
      font-size: 10.5px;
      letter-spacing: 0.16em;
    }
  }
  .hero-title {
    font-size: clamp(2.1rem, 5vw, 3.8rem);
    font-weight: 900;
    line-height: 0.94;
    margin: 0;
    text-align: left;
  }
  .hero-title .line {
    display: block;
  }
  .hero-title em {
    font-style: italic;
  }
  .hero-foot {
    display: grid;
    justify-items: center;
    gap: 1.75rem;
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }
  .hero-foot .lead {
    margin: 0;
  }
  /* Phones: the WhatsApp button full width, and Services as a quiet underlined link under it */
  @media (max-width: 520px) {
    .hero-foot {
      justify-items: stretch;
    }
    .hero-foot .actions {
      flex-direction: column;
      align-items: center;
      gap: 0.9rem;
    }
    .hero-foot .actions :global(.btn--whatsapp) {
      width: 100%;
      padding-block: 0.9rem;
    }
    .hero-foot .actions .hero-services {
      padding: 0.25rem 0;
      border: 0;
      border-radius: 0;
      background: none;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.35em;
    }
    .hero-foot .actions .hero-services:hover,
    .hero-foot .actions .hero-services:focus-visible {
      background: none;
      color: var(--text);
    }
  }

  /* ---------- Where ---------- */
  /* Sits close under the services ticker */
  .where-section {
    padding-top: clamp(2rem, 4vw, 3rem);
  }
  /* Section opener, centred like a magazine section title: a larger heading, the line in a
     narrow measure beneath it, and a full-width rule closing it off above the images */
  .where-head {
    display: grid;
    justify-items: center;
    gap: 0.85rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
    border-bottom: 1px solid var(--line);
    text-align: center;
  }
  .where-head h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .where-head p {
    margin: 0;
    max-width: 26rem;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--muted);
    text-wrap: balance;
  }
  .where {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 760px) {
    .where {
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(1.5rem, 4vw, 4rem);
    }
  }
  /* A long bar along the bottom of each image, carrying its label */
  .place-media {
    position: relative;
  }
  .place-bar {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    margin: 0;
    padding: 0.8rem clamp(1rem, 2vw, 1.4rem);
    background: rgba(11, 11, 11, 0.72);
    color: #ffffff;
    font-family: var(--font-nav);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  /* Short left-aligned caption under each image, lined up with its left edge */
  .place-text {
    max-width: 28rem;
    margin-top: 1.5rem;
    text-align: left;
  }
  .place-text h3 {
    margin-bottom: 0.9rem;
    font-size: 1rem;
    font-weight: 800;
  }
  .place-text > p {
    font-size: 1.02rem;
    line-height: 1.5;
  }
  .place-text p:last-child {
    margin: 0;
  }

  /* ---------- Training ticker ---------- */
  /* A solid pure-black band: no rules, white text */
  .services-ticker-section {
    padding-bottom: 0;
    background: #000000;
  }
  .ticker-strip {
    display: block;
    width: 100%;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .ticker-strip:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .ticker-viewport {
    overflow: hidden;
    padding-block: clamp(0.9rem, 2vw, 1.4rem);
  }
  /* translate3d + will-change keep the scroll on the GPU, so it glides instead of stepping */
  .ticker-track {
    display: flex;
    width: max-content;
    animation: services-marquee 45s linear infinite;
    will-change: transform;
    backface-visibility: hidden;
  }
  .ticker-group {
    display: flex;
    flex: none;
    align-items: center;
    gap: clamp(1.1rem, 2.3vw, 2.25rem);
    padding-inline: clamp(1rem, 2vw, 2rem);
    white-space: nowrap;
  }
  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: clamp(1.1rem, 2.3vw, 2.25rem);
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 1.35vw, 1.15rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.15;
  }
  .ticker-dot {
    display: inline-block;
    width: 1px;
    height: 1em;
    background: var(--accent);
  }
  .ticker-strip:hover .ticker-track,
  .ticker-strip:focus-within .ticker-track {
    animation-play-state: paused;
  }
  @keyframes services-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      width: 100%;
      animation: none;
      transform: none;
    }
    .ticker-group {
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
      white-space: normal;
    }
    .ticker-group + .ticker-group {
      display: none;
    }
    .ticker-item {
      gap: 0.75rem;
    }
  }

  /* ---------- Booking ---------- */
  .book {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 2.5rem);
  }
  .book-intro {
    text-align: center;
  }
  .book-intro h2 {
    margin-bottom: 1.5rem;
  }
  .book-intro p {
    max-width: 30rem;
    margin: 0 auto;
    font-size: 1.08rem;
  }
  /* The link sits centred under the buttons, its underline only as wide as its text */
  .book-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .book-actions .email-prompt {
    margin-top: 1.75rem;
  }
  .book-section :global(.actions .btn) {
    border-color: var(--accent);
    background: var(--accent);
    color: #ffffff;
  }
  .book-section :global(.actions .btn:hover),
  .book-section :global(.actions .btn:focus-visible) {
    border-color: #d46a3b;
    background: #d46a3b;
    color: #ffffff;
  }
  .book-section :global(.actions .btn:nth-child(2)) {
    border-color: #ffffff;
    background: #ffffff;
    color: var(--black);
  }
  .book-section :global(.actions .btn:nth-child(2):hover),
  .book-section :global(.actions .btn:nth-child(2):focus-visible) {
    border-color: #e8e8e8;
    background: #e8e8e8;
    color: var(--black);
  }
  /* ---------- Find me and get in touch ---------- */
  /* White, between the black booking band and the black footer */
  .location-sections {
    background: var(--bg);
  }
  /* Info stacked on the left, the map filling the right and matching the column's height */
  .location-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 860px) {
    .location-grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      column-gap: clamp(2rem, 3.5vw, 3rem);
      align-items: stretch;
    }
    /* Push the info to the right of its column so it sits up against the map */
    .location-copy {
      justify-self: end;
      width: min(100%, 22rem);
    }
  }
  .location-copy {
    display: grid;
    align-content: center;
  }
  .location-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .find-block {
    padding-bottom: clamp(1.75rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--line);
  }
  .contact-block {
    padding-top: clamp(1.75rem, 3vw, 2.25rem);
  }
  .location-block > h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
    line-height: 1.1;
    text-align: left;
  }
  .address-panel address {
    font-style: normal;
    color: var(--muted);
    line-height: 1.25;
  }
  .address-panel address span {
    display: block;
  }
  /* Nearest stations: ruled rows, name left, walk time right */
  .stations {
    align-self: stretch;
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }
  .stations li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.6rem;
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
  }
  .station-name {
    color: var(--text);
  }
  .station-walk {
    flex: none;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .location-copy :global(.location-action) {
    display: inline-flex;
    width: fit-content;
    min-height: 2.3rem;
    margin-top: 1.25rem;
    padding: 0.5rem 0.9rem;
    border-width: 1px;
    border-radius: 0;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.035em;
    white-space: nowrap;
  }
  .location-follow ul {
    display: grid;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .location-follow li > a,
  .location-follow li > span {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text);
    font-size: 0.95rem;
  }
  .location-follow a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 0.2s ease;
  }
  .location-follow a:hover,
  .location-follow a:focus-visible {
    text-decoration-color: var(--accent);
  }
  .social-icon {
    display: inline-grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    color: var(--muted);
  }
  .location-follow :global(.social-icon svg) {
    width: 100%;
    height: 100%;
  }
  /* The map, in full colour, with softly rounded corners */
  .map-frame {
    position: relative;
    overflow: hidden;
    min-height: 26rem;
    border-radius: 12px;
    background: var(--surface-2);
    box-shadow: 0 0 0 1px var(--line);
  }
  /* Google's embed always shows a place card in the top-left corner. The map is drawn taller than
     the frame and shifted up so that card sits outside the visible area; the bottom edge, with
     Google's required credit, stays in view. */
  .location-map {
    position: absolute;
    top: -130px;
    left: 0;
    display: block;
    width: 100%;
    height: calc(100% + 130px);
    border: 0;
  }
  @media (max-width: 859px) {
    .map-frame {
      min-height: 18rem;
    }
  }
</style>
