---
import Layout from '../layouts/Layout.astro';
import FollowMe from '../components/FollowMe.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import MediaRotator from '../components/MediaRotator.astro';
import CtaBand from '../components/CtaBand.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { BRAND, BASE_GYM, GYM_ADDRESS, SERVICES, SOCIALS, TRAINER, WHATSAPP_NUMBER, WHATSAPP_URL } from '../config';
import { withBase } from '../utils/paths';

const sameAs = Object.values(SOCIALS).filter(Boolean);
const phoneDisplay = `+${WHATSAPP_NUMBER.slice(0, 2)} ${WHATSAPP_NUMBER.slice(2, 6)} ${WHATSAPP_NUMBER.slice(6)}`;
const gymMapUrl = `https://www.google.com/maps?q=${encodeURIComponent(`${BASE_GYM}, ${GYM_ADDRESS}`)}&output=embed`;
const pound = '\u00a3';
const pricingOptions: { duration: string; price: string; perHour?: string; bestValue?: boolean }[] = [
  { duration: '[X] hour(s)', price: `${pound}[PRICE]` },
  { duration: '[X] hours', price: `${pound}[PRICE]`, perHour: `${pound}[PRICE] per hour` },
  { duration: '[X] hours', price: `${pound}[PRICE]`, perHour: `${pound}[PRICE] per hour` },
  { duration: '[X] hours', price: `${pound}[PRICE]`, perHour: `${pound}[PRICE] per hour`, bestValue: true },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  name: BRAND,
  description: `Personal trainer in central London. Training at ${BASE_GYM} and home visits across London.`,
  telephone: `+${WHATSAPP_NUMBER}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'London',
    addressCountry: 'GB',
  },
  areaServed: [
    { '@type': 'Place', name: 'Central London' },
    { '@type': 'City', name: 'London' },
  ],
  founder: { '@type': 'Person', name: TRAINER, jobTitle: 'Personal Trainer' },
  makesOffer: SERVICES.map((s) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: `${s.name} personal training` },
  })),
  ...(sameAs.length ? { sameAs } : {}),
};
---

<Layout
  title={`Personal Trainer Central London | ${BRAND}`}
  description={`Personal trainer in central London at ${BASE_GYM}, with home visits anywhere in London. Strength & conditioning, calisthenics, weight loss, body recomposition, mobility and rehab. Book an intro session on WhatsApp.`}
  schema={schema}
>
  <!-- Hero: full-bleed rotating media; headline set huge along the bottom -->
  <section class="hero on-dark">
    <MediaRotator />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container hero-content">
      <h1 class="hero-title">
        <span class="line" data-reveal style="--d: 1">Personal trainer</span>
        <span class="line accent" data-reveal style="--d: 2">in central London</span>
      </h1>

      <div class="hero-foot" data-reveal style="--d: 3">
        <p class="lead">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut
          labore et dolore magna aliqua.
        </p>
        <div class="hero-actions">
          <WhatsAppButton />
          <a class="btn btn--ghost" href={withBase('/services/')}>Services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Statement -->
  <section class="section statement-section">
    <div class="container statement">
      <p class="eyebrow" data-reveal>Train like an athlete</p>
      <!-- TODO (copy): replace with Mustafa's own statement, and say every plan is built around the client -->
      <p class="statement-text" data-reveal style="--d: 1">
        One-to-one training built the way athletes train: strength, skill and conditioning, planned
        around you, at {BASE_GYM} or in your own home.
      </p>
    </div>
  </section>

  <!-- Where I train clients: two columns side by side -->
  <section class="section where-section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Where I train clients</h2>
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod.</p>
      </div>
      <div class="where">
        <article class="place">
          <ImageSlot label={`Training a client at ${BASE_GYM}`} ratio="3 / 2" />
          <div class="place-text" data-reveal>
            <p class="eyebrow">Gym sessions</p>
            <h3>{BASE_GYM}</h3>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt.</p>
          </div>
        </article>
        <article class="place">
          <ImageSlot label="A home visit session" ratio="3 / 2" delay={1} />
          <div class="place-text" data-reveal style="--d: 1">
            <p class="eyebrow">Home visits</p>
            <h3>Anywhere in London</h3>
            <p>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- What I train: heading left, numbered index of services right -->
  <section class="section train-section">
    <div class="container train">
      <div class="train-head">
        <h2>What I train</h2>
        <a class="text-link" href={withBase('/services/')}>All services <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ol class="train-list">
        {
          SERVICES.map((s, i) => (
            <li>
              <a href={`${withBase('/services/')}#${s.slug}`}>
                <span class="train-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="train-name">{s.name}</span>
                <span class="train-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Session options: free first session, then a plain price list -->
  <section class="section on-dark sessions-section">
    <div class="container sessions">
      <div class="sessions-intro">
        <h2>Session options</h2>
        <p class="sessions-free">Your first session is <span class="accent">free.</span></p>
        <p>Meet me, talk through your goals and train together once before you commit to anything.</p>
        <WhatsAppButton label="Book your free session" />
      </div>
      <ul class="price-list">
        {
          pricingOptions.map((option) => (
            <li>
              <div class="price-what">
                <h3>{option.duration}</h3>
                {option.bestValue && <span class="price-tag">Best value</span>}
              </div>
              <div class="price-cost">
                <p class="price-amount">{option.price}</p>
                {option.perHour && <p class="price-rate">{option.perHour}</p>}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <CtaBand />

  <section class="section gym-location" aria-label="Gym address and contact">
    <div class="container location-grid">
      <div class="location-details">
        <div class="address-panel">
          <h2>Address</h2>
          <address>{BASE_GYM}<br />{GYM_ADDRESS}</address>
          <p class="station-label">Closest stations</p>
          <ul class="stations">
            <li>Great Portland Street - 5-minute walk</li>
            <li>Regent&#39;s Park - 5-minute walk</li>
          </ul>
        </div>
        <div class="location-follow">
          <h2>Follow my training</h2>
          <FollowMe showLabel={false} />
        </div>
        <a class="location-phone" href={WHATSAPP_URL} target="_blank" rel="noopener">
          Contact me on WhatsApp <span>{phoneDisplay}</span>
        </a>
      </div>
      <iframe
        class="location-map"
        src={gymMapUrl}
        title={`Map showing ${BASE_GYM}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </section>
</Layout>



<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(34rem, 84svh, 52rem);
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
    overflow: hidden;
  }
  /* Flat tint so the type stays readable over any photo */
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: rgba(11, 11, 11, 0.42);
  }
  .hero-content {
    position: relative;
    z-index: 2;
  }
  .hero-title {
    font-size: clamp(2.6rem, 7vw, 6.25rem);
    line-height: 1.02;
    margin: 0;
  }
  .hero-title .line {
    display: block;
  }
  .hero-foot {
    display: grid;
    gap: 1.75rem 4rem;
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .hero-foot .lead {
    margin: 0;
  }
  @media (min-width: 900px) {
    .hero-foot {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (max-width: 520px) {
    .hero-actions :global(.btn) {
      flex: 1 1 100%;
    }
  }

  /* ---------- Statement ---------- */
  .statement {
    display: grid;
    gap: 1rem 4rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .statement {
      grid-template-columns: 14rem 1fr;
    }
    .statement .eyebrow {
      padding-top: 0.55rem;
    }
  }
  .statement-section {
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }
  .statement-text {
    margin: 0;
    max-width: 46rem;
    font-size: clamp(1.25rem, 2.1vw, 1.65rem);
    line-height: 1.45;
    font-weight: 500;
    color: var(--text);
    text-wrap: pretty;
  }

  /* ---------- Where ---------- */
  .where-section {
    padding-top: 0;
  }
  .where {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 760px) {
    .where {
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(1.5rem, 4vw, 4rem);
    }
  }
  .place-text {
    margin-top: 1.25rem;
    max-width: 28rem;
  }
  .place-text h3 {
    margin-bottom: 0.9rem;
  }
  .place-text p:last-child {
    margin: 0;
  }

  /* ---------- What I train ---------- */
  .train-section {
    border-top: 1px solid var(--line);
  }
  .train {
    display: grid;
    gap: 2rem 4rem;
  }
  @media (min-width: 900px) {
    .train {
      grid-template-columns: 4fr 8fr;
      align-items: start;
    }
    .train-head {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
  .train-head h2 {
    margin-bottom: 1.5rem;
  }
  .train-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .train-list li {
    border-bottom: 1px solid var(--line);
  }
  .train-list a {
    display: grid;
    grid-template-columns: 2.75rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding-block: clamp(1rem, 2vw, 1.5rem);
    color: var(--text);
    text-decoration: none;
  }
  .train-num {
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--faint);
    transition: color 0.3s var(--ease);
  }
  .train-name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.6rem, 3.6vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    transition: transform 0.4s var(--ease);
  }
  .train-arrow {
    font-size: 1.25rem;
    color: var(--faint);
    transition:
      color 0.3s var(--ease),
      transform 0.4s var(--ease);
  }
  .train-list a:hover .train-name,
  .train-list a:focus-visible .train-name {
    transform: translateX(0.5rem);
  }
  .train-list a:hover :is(.train-num, .train-arrow),
  .train-list a:focus-visible :is(.train-num, .train-arrow) {
    color: var(--accent-text);
  }
  .train-list a:hover .train-arrow,
  .train-list a:focus-visible .train-arrow {
    transform: translateX(0.35rem);
  }

  /* ---------- Session options ---------- */
  .sessions {
    display: grid;
    gap: 2.5rem 4rem;
  }
  @media (min-width: 900px) {
    .sessions {
      grid-template-columns: 5fr 7fr;
      align-items: start;
    }
  }
  .sessions-intro h2 {
    margin-bottom: 1.5rem;
  }
  .sessions-free {
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.15;
    color: var(--text);
  }
  .sessions-intro p:not(.sessions-free) {
    max-width: 26rem;
    margin-bottom: 1.75rem;
  }
  .price-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .price-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: clamp(1.25rem, 2.5vw, 1.75rem);
    border-bottom: 1px solid var(--line);
  }
  .price-what {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
  }
  .price-what h3 {
    margin: 0;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
  }
  .price-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent-text);
  }
  .price-cost {
    text-align: right;
  }
  .price-amount {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    line-height: 1;
    color: var(--text);
  }
  .price-rate {
    margin: 0.4rem 0 0;
    font-size: 0.8rem;
    color: var(--faint);
  }

  /* ---------- Gym address ---------- */
  .gym-location {
    padding-block: clamp(1.5rem, 2.5vw, 2.25rem);
    background: var(--surface);
  }
  .location-grid {
    display: grid;
    gap: clamp(1rem, 2.5vw, 2rem);
    align-items: center;
  }
  @media (min-width: 760px) {
    .location-grid {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }
  .location-details {
    display: grid;
    gap: 0.85rem;
    align-content: center;
  }
  @media (min-width: 760px) {
    .location-details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
    .location-phone {
      grid-column: 1 / -1;
    }
  }
  .location-details address {
    font-style: normal;
    color: var(--text);
    font-weight: 600;
  }
  .location-details h2 {
    margin-bottom: 0.65rem;
    font-size: clamp(1.5rem, 2.2vw, 2rem);
  }
  .station-label {
    margin: 0.9rem 0 0.25rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--faint);
  }
  .location-follow :global(.follow) {
    display: block;
    font-size: 0.9rem;
    letter-spacing: 0;
  }
  .location-follow :global(.follow ul) {
    gap: 0.85rem;
    margin-top: 0.75rem;
  }
  .location-follow :global(.follow a),
  .location-follow :global(.follow .soon) {
    color: var(--text);
    font-size: 0.88rem;
  }
  .stations {
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--muted);
  }
  .stations li + li {
    margin-top: 0.2rem;
  }
  .location-phone {
    width: fit-content;
    display: grid;
    gap: 0.2rem;
    color: var(--text);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
    font-weight: 600;
  }
  .location-phone span {
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 400;
  }
  .location-map {
    display: block;
    width: 100%;
    max-width: 46.5rem;
    height: clamp(15rem, 28vw, 25rem);
    border: 0;
    background: var(--surface-2);
  }

</style>
