---
import Layout from '../layouts/Layout.astro';
import FollowMe from '../components/FollowMe.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import MediaRotator from '../components/MediaRotator.astro';
import ImageSlot from '../components/ImageSlot.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import { BRAND, BASE_GYM, GYM_ADDRESS, SERVICES, SOCIALS, TRAINER, WHATSAPP_NUMBER, WHATSAPP_URL } from '../config';
import { withBase } from '../utils/paths';

const sameAs = Object.values(SOCIALS).filter(Boolean);
const phoneDisplay = `+${WHATSAPP_NUMBER.slice(0, 2)} ${WHATSAPP_NUMBER.slice(2, 6)} ${WHATSAPP_NUMBER.slice(6)}`;
const gymMapUrl = `https://www.google.com/maps?q=${encodeURIComponent(`${BASE_GYM}, ${GYM_ADDRESS}`)}&output=embed`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${BASE_GYM}, ${GYM_ADDRESS}`)}`;
const pound = '\u00a3';
const pricingOptions: { duration: string; price: string; perHour?: string; bestValue?: boolean }[] = [
  { duration: '[X] hour(s)', price: `${pound}[PRICE]` },
  { duration: '[X] hours', price: `${pound}[PRICE]`, perHour: `${pound}[PRICE] per hour` },
  { duration: '[X] hours', price: `${pound}[PRICE]`, perHour: `${pound}[PRICE] per hour` },
  { duration: '[X] hours', price: `${pound}[PRICE]`, perHour: `${pound}[PRICE] per hour`, bestValue: true },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  name: BRAND,
  description: `Personal trainer in central London. Training at ${BASE_GYM} and home visits across London.`,
  telephone: `+${WHATSAPP_NUMBER}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'London',
    addressCountry: 'GB',
  },
  areaServed: [
    { '@type': 'Place', name: 'Central London' },
    { '@type': 'City', name: 'London' },
  ],
  founder: { '@type': 'Person', name: TRAINER, jobTitle: 'Personal Trainer' },
  makesOffer: SERVICES.map((s) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: `${s.name} personal training` },
  })),
  ...(sameAs.length ? { sameAs } : {}),
};
---

<Layout
  title={`Personal Trainer Central London | ${BRAND}`}
  description={`Personal trainer in central London at ${BASE_GYM}, with home visits anywhere in London. Strength & conditioning, calisthenics, weight loss, body recomposition, mobility and rehab. Book an intro session on WhatsApp.`}
  schema={schema}
>
  <!-- Hero: full-bleed rotating media; headline set huge along the bottom -->
  <section class="hero on-dark">
    <MediaRotator />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container hero-content">
      <h1 class="hero-title">
        <span class="line" data-reveal style="--d: 1">Personal trainer</span>
        <span class="line accent" data-reveal style="--d: 2">in central London</span>
      </h1>

      <div class="hero-foot" data-reveal style="--d: 3">
        <p class="lead">
          One-to-one sessions at {BASE_GYM} or in your own home. I train you the way I train
          athletes, with a plan built around your goals.
        </p>
        <div class="hero-actions">
          <WhatsAppButton />
          <a class="btn btn--ghost" href={withBase('/services/')}>Services</a>
        </div>
      </div>
    </div>
  </section>

  <GoogleReviews />

  <!-- Where I train clients: two columns side by side -->
  <section class="section where-section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Where I train clients</h2>
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod.</p>
      </div>
      <div class="where">
        <article class="place">
          <ImageSlot
            label={`Training at ${BASE_GYM}`}
            src="/media/fitness_first_video.mp4"
            type="video"
            ratio="3 / 2"
          />
          <div class="place-text" data-reveal>
            <p class="eyebrow">Gym sessions</p>
            <h3>{BASE_GYM}</h3>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt.</p>
          </div>
        </article>
        <article class="place">
          <ImageSlot label="A home visit session" ratio="3 / 2" delay={1} />
          <div class="place-text" data-reveal style="--d: 1">
            <p class="eyebrow">Home visits</p>
            <h3>Anywhere in London</h3>
            <p>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="services-ticker-section" aria-label="Training services">
    <p class="visually-hidden">
      Strength &amp; conditioning, Sport-specific training, Calisthenics, Body recomposition, Weight loss, Mobility &amp; flexibility, Rehabilitation.
    </p>
    <div class="ticker-strip">
      <div class="ticker-viewport">
        <div class="ticker-track">
          {[0, 1].map(() => (
            <div class="ticker-group" aria-hidden="true">
              {SERVICES.map((service) => (
                <span class="ticker-item">{service.name}<span class="ticker-dot">·</span></span>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="container ticker-link-wrap">
      <a class="ticker-link" href={withBase('/services/')}>View all services</a>
    </div>
  </section>

  <!-- Pricing: free first session, then a plain price list -->
  <section class="section on-dark sessions-section" id="pricing">
    <div class="container sessions">
      <div class="sessions-intro">
        <h2>Pricing</h2>
        <p class="sessions-free">Your first session is <span class="accent">free.</span></p>
        <p>Meet me, talk through your goals and train together once before you commit to anything.</p>
        <WhatsAppButton label="Book your free session" />
      </div>
      <ul class="price-list">
        {
          pricingOptions.map((option) => (
            <li>
              <div class="price-what">
                <h3>{option.duration}</h3>
                {option.bestValue && <span class="price-tag">Best value</span>}
              </div>
              <div class="price-cost">
                <p class="price-amount">{option.price}</p>
                {option.perHour && <p class="price-rate">{option.perHour}</p>}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <section class="section location-sections" aria-label="Location and contact">
    <div class="container location-sections-inner">
      <section class="location-block find-block" aria-labelledby="find-heading">
        <h2 id="find-heading">Find me</h2>
        <div class="find-grid">
          <div class="address-panel">
            <p class="gym-name">{BASE_GYM}</p>
            <address>{GYM_ADDRESS}</address>
            <p class="station-label">Closest stations</p>
            <ul class="stations">
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-1l2 3h-2l-2-3h-4l-2 3H6l2-3H7a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Zm0 2a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1H7Zm1 2h3v4H8V7Zm5 0h3v4h-3V7Z"/></svg>
                <span>Great Portland Street Â· 5 min walk</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-1l2 3h-2l-2-3h-4l-2 3H6l2-3H7a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Zm0 2a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1H7Zm1 2h3v4H8V7Zm5 0h3v4h-3V7Z"/></svg>
                <span>Regent&#39;s Park Â· 5 min walk</span>
              </li>
            </ul>
            <a class="btn btn--primary directions-button" href={directionsUrl} target="_blank" rel="noopener">Get directions</a>
          </div>
          <div class="map-frame">
            <iframe
              class="location-map"
              src={gymMapUrl}
              title={`Map showing ${BASE_GYM}`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
            <span class="map-pin" aria-hidden="true"><span></span></span>
          </div>
        </div>
      </section>

      <section class="location-block contact-block" aria-labelledby="contact-heading">
        <h2 id="contact-heading">Get in touch</h2>
        <div class="contact-grid">
          <div>
            <h3>Message me on WhatsApp</h3>
            <p class="contact-number">{phoneDisplay}</p>
            <WhatsAppButton label="Message me on WhatsApp" />
          </div>
          <div class="location-follow">
            <h3>Follow my training</h3>
            <FollowMe showLabel={false} showArrows={false} />
          </div>
        </div>
      </section>
    </div>
  </section>
</Layout>



<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(34rem, 84svh, 52rem);
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
    overflow: hidden;
  }
  /* Flat tint so the type stays readable over any photo */
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: rgba(11, 11, 11, 0.42);
  }
  .hero-content {
    position: relative;
    z-index: 2;
  }
  .hero-title {
    font-size: clamp(2.6rem, 7vw, 6.25rem);
    line-height: 1.02;
    margin: 0;
  }
  .hero-title .line {
    display: block;
  }
  .hero-foot {
    display: grid;
    gap: 1.75rem 4rem;
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .hero-foot .lead {
    margin: 0;
  }
  @media (min-width: 900px) {
    .hero-foot {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (max-width: 520px) {
    .hero-actions :global(.btn) {
      flex: 1 1 100%;
    }
  }

  /* ---------- Where ---------- */
  .where-section {
    padding-top: 0;
  }
  .where {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 760px) {
    .where {
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(1.5rem, 4vw, 4rem);
    }
  }
  .place-text {
    margin-top: 1.25rem;
    max-width: 28rem;
  }
  .place-text h3 {
    margin-bottom: 0.9rem;
  }
  .place-text p:last-child {
    margin: 0;
  }

  /* ---------- Training ticker ---------- */
  .services-ticker-section {
    padding-bottom: 0.4rem;
  }
  .ticker-strip {
    width: 100%;
    overflow: hidden;
    border-block: 1px solid var(--line);
  }
  .ticker-viewport {
    overflow: hidden;
    padding-block: clamp(0.9rem, 2vw, 1.4rem);
  }
  .ticker-track {
    display: flex;
    width: max-content;
    animation: services-marquee 40s linear infinite;
  }
  .ticker-group {
    display: flex;
    flex: none;
    align-items: center;
    gap: clamp(1.1rem, 2.3vw, 2.25rem);
    padding-inline: clamp(1rem, 2vw, 2rem);
    white-space: nowrap;
  }
  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: clamp(1.1rem, 2.3vw, 2.25rem);
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
  }
  .ticker-dot {
    color: var(--accent);
  }
  .ticker-strip:hover .ticker-track,
  .ticker-strip:focus-within .ticker-track {
    animation-play-state: paused;
  }
  .ticker-link-wrap {
    display: flex;
    justify-content: flex-end;
    padding-top: 0.55rem;
  }
  .ticker-link {
    color: var(--muted);
    font-size: 0.82rem;
    text-decoration: none;
    text-underline-offset: 0.25em;
    transition: color 0.2s ease;
  }
  .ticker-link:hover,
  .ticker-link:focus-visible {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  @keyframes services-marquee {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      width: 100%;
      animation: none;
      transform: none;
    }
    .ticker-group {
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
      white-space: normal;
    }
    .ticker-group + .ticker-group {
      display: none;
    }
    .ticker-item {
      gap: 0.75rem;
    }
  }

  /* ---------- Pricing ---------- */
  .sessions {
    display: grid;
    gap: 2.5rem 4rem;
  }
  @media (min-width: 900px) {
    .sessions {
      grid-template-columns: 5fr 7fr;
      align-items: start;
    }
  }
  .sessions-intro h2 {
    margin-bottom: 1.5rem;
  }
  .sessions-free {
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.15;
    color: var(--text);
  }
  .sessions-intro p:not(.sessions-free) {
    max-width: 26rem;
    margin-bottom: 1.75rem;
  }
  .price-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .price-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    position: relative;
    padding-block: clamp(1.25rem, 2.5vw, 1.75rem);
    border-bottom: 1px solid var(--line);
  }
  /* Hover (mouse only): the row under the pointer stays bright, the rest fall back,
     and an orange hairline draws across beneath it */
  @media (hover: hover) {
    .price-list li {
      transition: opacity 0.45s var(--ease);
    }
    .price-list:hover li:not(:hover) {
      opacity: 0.4;
    }
    .price-list li::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 1px;
      background: var(--accent);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.7s var(--ease);
    }
    .price-list li:hover::after {
      transform: scaleX(1);
    }
    .price-what h3 {
      transition: transform 0.45s var(--ease);
    }
    .price-list li:hover .price-what h3 {
      transform: translateX(0.5rem);
    }
  }
  .price-what {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
  }
  .price-what h3 {
    margin: 0;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
  }
  .price-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent-text);
  }
  .price-cost {
    text-align: right;
  }
  .price-amount {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    line-height: 1;
    color: var(--text);
  }
  .price-rate {
    margin: 0.4rem 0 0;
    font-size: 0.8rem;
    color: var(--faint);
  }

  /* ---------- Find me and get in touch ---------- */
  .location-sections {
    padding-block: clamp(2rem, 5vw, 4.5rem);
    background: var(--surface);
  }
  .location-sections-inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  .location-block > h2 {
    margin: 0 0 clamp(1.25rem, 2.5vw, 2rem);
    font-size: clamp(1.7rem, 3vw, 2.4rem);
  }
  .find-grid,
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: stretch;
  }
  .gym-name {
    margin: 0 0 0.3rem;
    color: var(--text);
    font-weight: 700;
  }
  .address-panel address {
    font-style: normal;
    color: var(--muted);
    font-weight: 400;
  }
  .station-label {
    margin: 1.3rem 0 0.45rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text);
  }
  .stations {
    display: grid;
    gap: 0.55rem;
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--muted);
    line-height: 1.45;
  }
  .stations li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .stations svg {
    flex: 0 0 1rem;
    width: 1rem;
    height: 1rem;
    fill: var(--accent);
  }
  .directions-button {
    margin-top: 1.5rem;
  }
  .map-frame {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 1.84;
    min-height: 17rem;
    border-radius: 0.75rem;
    background: var(--surface-2);
  }
  .location-map {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .map-pin {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.55rem;
    height: 1.55rem;
    transform: translate(-50%, -100%) rotate(-45deg);
    border-radius: 50% 50% 50% 0;
    background: var(--accent);
    box-shadow: 0 2px 8px rgb(0 0 0 / 28%);
    pointer-events: none;
  }
  .map-pin span {
    position: absolute;
    top: 0.42rem;
    left: 0.42rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: white;
  }
  .contact-grid > div > h3 {
    margin: 0 0 0.55rem;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
  }
  .contact-number {
    margin: 0 0 1.1rem;
    color: var(--muted);
  }
  .location-follow :global(.follow) {
    display: block;
    font-size: 1rem;
    letter-spacing: 0;
  }
  .location-follow :global(.follow ul) {
    gap: 1.5rem;
    margin-top: 0.75rem;
  }
  .location-follow :global(.follow a),
  .location-follow :global(.follow .soon) {
    color: var(--text);
    font-size: 1rem;
  }
  .location-follow :global(.follow a) {
    text-decoration: none;
  }
  .location-follow :global(.follow a:hover),
  .location-follow :global(.follow a:focus-visible) {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.25em;
  }
  @media (max-width: 700px) {
    .find-grid,
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      align-items: start;
    }
    .map-frame {
      aspect-ratio: 1.84;
      min-height: 13rem;
    }
  }

</style>
