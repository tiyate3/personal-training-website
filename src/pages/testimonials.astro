---
import Layout from '../layouts/Layout.astro';
import ImageSlot from '../components/ImageSlot.astro';
import CtaBand from '../components/CtaBand.astro';

/*
 * EXAMPLE CONTENT: replace with real client testimonials.
 * Only publish a Transformation (before/after photos) once the client has given written consent.
 * Set `before`/`after` to image paths in /public/media once available.
 */
const transformations: {
  name: string;
  service: string;
  quote: string;
  result: string;
  before?: string;
  after?: string;
}[] = [
  {
    name: 'Client name',
    service: 'Weight Loss',
    quote:
      "Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.",
    result: 'Example result',
  },
  {
    name: 'Client name',
    service: 'Body Recomposition',
    quote:
      "Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.",
    result: 'Example result',
  },
];

const quotes = [
  {
    name: 'Client name',
    service: 'Rehabilitation',
    quote: 'Curabitur pretium tincidunt lacus, nulla gravida orci a odio.',
  },
  {
    name: 'Client name',
    service: 'Calisthenics',
    quote: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.',
  },
  {
    name: 'Client name',
    service: 'Strength & Conditioning',
    quote: 'Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
  },
];
---

<Layout
  title="Client Testimonials & Transformations"
  description="Real results from real clients. Before-and-after transformations and testimonials from people I've trained in central London."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Testimonials</p>
      <h1>Real<br /><span class="accent">results</span></h1>
      <p class="lead">Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
    </div>
  </section>

  <section class="section">
    <div class="container stack">
      {
        transformations.map((t) => (
          <article class="transformation">
            <div class="photos">
              <div>
                <ImageSlot label="Before" src={t.before} ratio="3 / 4" />
                <span class="tag">Before</span>
              </div>
              <div>
                <ImageSlot label="After" src={t.after} ratio="3 / 4" />
                <span class="tag tag--after">After</span>
              </div>
            </div>
            <div class="story">
              <p class="result">{t.result}</p>
              <blockquote>“{t.quote}”</blockquote>
              <p class="who">
                <strong>{t.name}</strong> · {t.service}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow">What clients say</p>
      <h2>In their<br /><span class="accent">words</span></h2>
      <div class="quotes">
        {
          quotes.map((q) => (
            <figure class="quote">
              <span class="mark" aria-hidden="true">“</span>
              <blockquote>{q.quote}</blockquote>
              <figcaption>
                <strong>{q.name}</strong> · {q.service}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand title="Your story <span class='accent'>next</span>" />
</Layout>

<style>
  .stack {
    display: grid;
    gap: clamp(4rem, 10vw, 7rem);
  }
  .transformation {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .transformation {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
  .photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .photos > div {
    position: relative;
  }
  .tag {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgba(5, 5, 6, 0.85);
    border: 1px solid var(--line);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .tag--after {
    color: var(--green);
    border-color: var(--green);
  }
  .result {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 3rem);
    text-transform: uppercase;
    line-height: 1;
    color: var(--green);
  }
  blockquote {
    margin: 0 0 1.5rem;
    font-size: 1.15rem;
    color: var(--text);
  }
  .who,
  figcaption {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .who strong,
  figcaption strong {
    color: var(--text);
  }
  .quotes {
    display: grid;
    gap: 1.25rem;
    margin-top: 3rem;
  }
  @media (min-width: 860px) {
    .quotes {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .quote {
    margin: 0;
    padding: 2.25rem;
    background: var(--charcoal-2);
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .quote blockquote {
    font-size: 1.05rem;
  }
  .mark {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 4rem;
    line-height: 0.6;
    color: var(--green);
    margin-bottom: 1rem;
  }
</style>
