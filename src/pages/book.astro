---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { BASE_AREA } from '../config';

/*
 * FAQ. Answers marked TODO make no promises yet: confirm the facts with Mustafa, then fill them in.
 */
const faqs = [
  {
    q: 'How much does it cost?',
    a: "It depends on your plan and how often you train. Message me and I'll send you my rates.",
  },
  {
    q: 'How far do you travel for home visits, and do you do online sessions?',
    a: "Home visits cover central London. Send me your postcode if you're unsure and I'll confirm. I offer online coaching as well; get in contact to find out more.",
  },
  {
    q: "I'm a complete beginner. Is that okay?",
    a: "Yes. Every plan starts from where you are now. We build the basics first and progress at a pace that suits you.",
  },
  {
    q: 'Do I need a gym membership to train with you at the gym?',
    a: "Contact me. If the gym isn't for you, we can discuss alternative options.",
  },
  {
    // TODO: confirm what the first session involves, and whether it's free or a normal paid session.
    q: 'What happens in the first session?',
    a: 'We talk through your goals, check how you move, and do a first workout pitched to your level, so you leave with a clear idea of the plan.',
  },
];
---

<Layout
  title="Book a Session | Personal Trainer in Central London"
  description={`Book a one-to-one personal training session in ${BASE_AREA} or at home across central London. Message me on WhatsApp or send an enquiry.`}
>
  <PageHead
    title="Book a session"
    intro="Message me for the quickest reply, or fill in the form below and I'll get back to you as soon as I can."
    variant="band"
  />

  <!-- WhatsApp first, then the form as a white card on pale grey -->
  <section class="section book-page">
    <div class="container narrow book-column">
      <WhatsAppButton label="Message me on WhatsApp" class="book-whatsapp" />
      <h2 class="form-heading">Or fill in the form below</h2>
      <div class="form-card">
        <EnquiryForm />
      </div>
    </div>
  </section>

  <!-- FAQs: a black band closing the page; each answer opens under its question -->
  <section class="section on-dark faq-section" aria-labelledby="faq-heading">
    <div class="container narrow">
      <h2 id="faq-heading" class="form-heading">FAQs</h2>
      <div class="faq">
        {
          faqs.map((f) => (
            <details class="faq-item">
              <summary>
                {f.q}
                <span class="faq-mark" aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Everything centred in one column; the button runs the full width of the form */
  .book-page {
    background: var(--surface);
    padding-top: clamp(2rem, 4vw, 3rem) !important;
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .faq-section {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--black);
  }
  .book-column {
    text-align: center;
  }
  .book-column :global(.book-whatsapp) {
    width: 100%;
    border-color: var(--black);
    background: var(--black);
    color: #ffffff;
  }
  /* WhatsApp starts black and turns orange on hover. */
  .book-column :global(.book-whatsapp:hover),
  .book-column :global(.book-whatsapp:focus-visible) {
    border-color: #d46a3b;
    background: #d46a3b;
    color: #ffffff;
  }
  .form-card {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--line);
    background: var(--bg);
    text-align: left;
  }
  .faq {
    text-align: left;
  }
  .faq-item {
    border-top: 1px solid var(--line);
  }
  .faq-item:last-of-type {
    border-bottom: 1px solid var(--line);
  }
  .faq-item summary {
    position: relative;
    padding: 1.1rem 2.5rem 1.1rem 0;
    list-style: none;
    cursor: pointer;
    font-weight: 700;
    color: var(--text);
    text-transform: uppercase;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  /* A plus that turns into a minus when open */
  .faq-mark {
    position: absolute;
    top: 50%;
    right: 0.25rem;
    width: 0.85rem;
    height: 0.85rem;
    transform: translateY(-50%);
  }
  .faq-mark::before,
  .faq-mark::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.3s var(--ease);
  }
  .faq-mark::after {
    transform: rotate(90deg);
  }
  .faq-item[open] .faq-mark::after {
    transform: rotate(0deg);
  }
  .faq-item p {
    margin: 0 0 1.25rem;
    max-width: 38rem;
    color: var(--muted);
  }
  .form-heading {
    margin: clamp(2rem, 4vw, 2.75rem) 0 clamp(1.25rem, 2.5vw, 1.75rem);
    text-align: center;
  }
  .faq-section .form-heading {
    margin-top: 0;
  }
</style>
