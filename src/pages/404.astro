    <div class="container">
      <h1>Page <span class="accent">not found</span></h1>
      <p class="lead">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
      <a class="btn btn--primary" href={withBase('/')}>Back to home</a>
