---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/paths';
---

<Layout title="Page not found" description="This page doesn't exist.">
  <section class="page-hero" style="min-height: 80vh;">
    <div class="container narrow">
      <h1>Page not found</h1>
      <div class="hero-foot">
        <p class="lead">This page doesn't exist, or it has moved.</p>
        <div><a class="btn btn--primary" href={withBase('/')}>Back to home</a></div>
      </div>
    </div>
  </section>
</Layout>
