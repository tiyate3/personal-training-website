---
import Layout from '../layouts/Layout.astro';
import ImageSlot from '../components/ImageSlot.astro';
import CtaBand from '../components/CtaBand.astro';
import FollowMe from '../components/FollowMe.astro';
import { BASE_GYM, BRAND } from '../config';

/*
 * EXAMPLE CONTENT: replace with Mustafa's real story and qualifications before launch.
 * Everything on this page is written in his voice as a starting draft.
 */

// TODO: replace with Mustafa's real qualifications.
const qualifications = [
  { title: 'Lorem ipsum dolor sit amet', detail: 'Lorem ipsum dolor sit amet' },
  { title: 'Consectetur adipiscing elit', detail: 'Lorem ipsum dolor sit amet' },
  { title: 'Sed do eiusmod tempor', detail: 'Lorem ipsum dolor sit amet' },
];

const principles = [
  { title: 'Lorem ipsum dolor sit amet', text: 'Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.' },
  { title: 'Consectetur adipiscing elit', text: 'Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.' },
  { title: 'Sed do eiusmod tempor', text: 'Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.' },
];
---

<Layout
  title="About Mustafa | Personal Trainer in Central London"
  description={`Meet Mustafa, the personal trainer behind ${BRAND}. Based at ${BASE_GYM} in central London. My story, training philosophy and what drives me.`}
>
  <section class="page-hero">
    <div class="container">
      <div class="hero-follow"><FollowMe /></div>
      <h1>About <span class="accent">Mustafa</span></h1>
      <p class="lead">
        Curabitur pretium tincidunt lacus, nulla gravida orci a odio. Lorem ipsum dolor sit amet, consectetur adipiscing elit.
      </p>
    </div>
  </section>

  <!-- History -->
  <section class="section">
    <div class="container grid-2">
      <ImageSlot label="Portrait of Mustafa" ratio="4 / 5" />
      <div>
        <h2>My story</h2>
        <!-- TODO: replace with Mustafa's real history -->
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
        <p>Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
        <p>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</p>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="section section--alt">
    <div class="container">
      <h2>How I train</h2>
      <div class="principles">
        {
          principles.map((p) => (
            <div class="principle">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Qualifications -->
  <section class="section section--alt">
    <div class="container">
      <h2>Qualifications</h2>
      <ul class="quals">
        {
          qualifications.map((q) => (
            <li>
              <span class="tick" aria-hidden="true" />
              <div>
                <strong>{q.title}</strong>
                <span>{q.detail}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  .hero-follow {
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }
  .principles {
    display: grid;
    gap: 0 3rem;
    margin-top: 2rem;
  }
  @media (min-width: 860px) {
    .principles {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .principle {
    padding: 1.5rem 0 1rem;
    border-top: 1px solid var(--line);
  }
  .quals {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    column-gap: 3rem;
  }
  @media (min-width: 760px) {
    .quals {
      grid-template-columns: 1fr 1fr;
    }
  }
  .quals li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
  }
  .quals strong {
    display: block;
    font-size: 1.05rem;
  }
  .quals span:not(.tick) {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .tick {
    flex: none;
    width: 0.9rem;
    height: 2px;
    margin-top: 0.8rem;
    background: var(--accent);
  }
</style>
