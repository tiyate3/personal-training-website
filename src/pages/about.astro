const qualifications = [
  { title: 'Level 3 Personal Trainer', detail: 'Lorem ipsum dolor sit amet' },
  { title: 'Strength & Conditioning Coach', detail: 'Lorem ipsum dolor sit amet' },
  { title: 'Sports Injury & Rehabilitation', detail: 'Lorem ipsum dolor sit amet' },
  { title: 'First Aid & CPR', detail: 'Lorem ipsum dolor sit amet' },
