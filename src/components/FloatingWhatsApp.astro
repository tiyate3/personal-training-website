---
import Icon from './Icon.astro';
import { WHATSAPP_URL } from '../config';
---

<a class="fab" href={WHATSAPP_URL} target="_blank" rel="noopener" data-umami-event="WhatsApp click" aria-label="Message Mustafa on WhatsApp">
  <Icon name="whatsapp" />
  <span class="tip" aria-hidden="true">Book a session</span>
</a>

<style>
  .fab {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 60;
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--black);
    border: 1px solid var(--black);
    box-shadow: none;
    transition: transform 0.25s, background 0.25s;
  }
  .fab:hover {
    transform: scale(1.06);
    background: #d36b42;
  }
  .fab :global(svg) {
    width: 1.9rem;
    height: 1.9rem;
  }
  .tip {
    position: absolute;
    right: calc(100% + 0.75rem);
    white-space: nowrap;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: var(--black);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    opacity: 0;
    transform: translateX(6px);
    transition: 0.2s;
    pointer-events: none;
  }
  .fab:hover .tip,
  .fab:focus-visible .tip {
    opacity: 1;
    transform: none;
  }
</style>
