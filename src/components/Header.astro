---
import { BRAND, NAV } from '../config';
import WhatsAppButton from './WhatsAppButton.astro';
import logo from '../assets/mustafatheathlete-logo.svg';
import logoWhite from '../assets/mustafatheathlete-logo-white.svg';
import { withBase } from '../utils/paths';

// Current page path with the deploy base stripped, always in the form '/services/'
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
let path = Astro.url.pathname;
if (base && path.startsWith(base)) path = path.slice(base.length);
path = `/${path.replace(/^\/+/, '')}`;
if (!path.endsWith('/')) path += '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!--
  Transparent with the white logo while it sits over the black hero at the top of every page;
  turns solid white with the black logo once the page scrolls past the hero (or the menu opens).
-->
<header class="header">
  <div class="container bar">
    <a class="logo" href={withBase('/')} aria-label={`${BRAND} home`}>
      <img class="logo-white" src={logoWhite.src} width="550" height="200" alt="" />
      <img class="logo-black" src={logo.src} width="550" height="200" alt="" />
    </a>

    <nav class="nav" id="site-nav" aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.href === '/services/' ? 'Training' : item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <WhatsAppButton class="nav-cta" variant="ghost" label="Book a session" icon={false} />
    </nav>

    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Menu</span>
      <span class="bars" aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.header');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('open', !open);
    header?.classList.toggle('menu-open', !open);
    document.body.style.overflow = open ? '' : 'hidden';
  });

  // Clear over the top of the hero; once scrolled, the header takes on the colour of whatever
  // section is passing underneath it: black over black sections, white over light ones.
  const update = () => {
    if (!header) return;
    const scrolled = window.scrollY > 8;
    const y = header.offsetHeight + 1;
    const under = document
      .elementsFromPoint(window.innerWidth / 2, y)
      .find((el) => !header.contains(el) && !el.closest('.fab'));
    const dark = !!under?.closest('.on-dark, .page-hero');
    header.classList.toggle('dark-solid', scrolled && dark);
    header.classList.toggle('solid', scrolled && !dark);
  };
  update();
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s;
  }
  /* Over the hero: dark tokens, so nav text and menu bars are white */
  .header:not(.solid, .menu-open) {
    --text: #ffffff;
    --muted: rgba(255, 255, 255, 0.72);
    --line: rgba(255, 255, 255, 0.25);
  }
  .header.solid,
  .header.menu-open {
    border-bottom-color: var(--line);
  }
  /* Flat backing colour on a pseudo-element, so it can fade in without touching the fixed mobile menu */
  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #ffffff;
    opacity: 0;
    transition: opacity 0.25s;
  }
  .header.solid::before,
  .header.menu-open::before {
    opacity: 1;
  }
  .header.dark-solid::before {
    opacity: 1;
    background: var(--black);
  }
  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .logo {
    display: block;
    flex: none;
    /* The logo files carry generous padding, so the image is taller than the visible mark */
    margin-left: -0.6rem;
  }
  .logo img {
    height: 60px;
    width: auto;
  }
  .logo-black,
  .header.solid .logo-white,
  .header.menu-open .logo-white {
    display: none;
  }
  .header.solid .logo-black,
  .header.menu-open .logo-black {
    display: block;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }
  .nav ul {
    display: flex;
    gap: 2.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    position: relative;
    font-family: var(--font-display);
    font-size: 0.94rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
    color: var(--muted);
    transition: color 0.3s var(--ease);
  }
  .nav ul a:hover,
  .nav ul a:focus-visible,
  .nav ul a[aria-current='page'] {
    color: var(--text);
  }
  /* Hairline underline: draws in from the left on hover, stays on the current page */
  .nav ul a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease);
  }
  .nav ul a:hover::after,
  .nav ul a:focus-visible::after,
  .nav ul a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .nav :global(.nav-cta) {
    padding: 0.7rem 1.25rem;
    border-width: 1px;
    border-radius: 0;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 400;
    letter-spacing: 0.04em;
  }
  .nav :global(.nav-cta:hover),
  .nav :global(.nav-cta:focus-visible) {
    transform: none;
  }
  /* Over dark backgrounds the button fills white on hover, so its label turns black */
  .header:not(.solid, .menu-open) .nav :global(.nav-cta:hover),
  .header:not(.solid, .menu-open) .nav :global(.nav-cta:focus-visible) {
    color: var(--black);
  }
  .menu-toggle {
    display: none;
  }

  @media (max-width: 960px) {
    .menu-toggle {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      margin-right: -0.6rem;
      padding: 0;
      background: none;
      border: 0;
      cursor: pointer;
    }
    /* Two thin lines that cross into an X when the menu is open */
    .bars {
      position: relative;
      display: block;
      width: 24px;
      height: 8px;
    }
    .bars::before,
    .bars::after {
      content: '';
      position: absolute;
      left: 0;
      width: 100%;
      height: 1.5px;
      background: var(--text);
      transition: transform 0.4s var(--ease);
    }
    .bars::before {
      top: 0;
    }
    .bars::after {
      bottom: 0;
    }
    .menu-toggle[aria-expanded='true'] .bars::before {
      transform: translateY(3.25px) rotate(45deg);
    }
    .menu-toggle[aria-expanded='true'] .bars::after {
      transform: translateY(-3.25px) rotate(-45deg);
    }
    .nav {
      position: fixed;
      top: var(--header-h);
      left: 0;
      right: 0;
      height: calc(100dvh - var(--header-h));
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 2.5rem;
      padding: 3rem var(--pad);
      background: var(--bg);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.4s var(--ease),
        visibility 0.4s;
    }
    .nav.open {
      opacity: 1;
      visibility: visible;
    }
    .nav ul {
      flex-direction: column;
      gap: 1.5rem;
    }
    .nav ul a {
      font-size: clamp(1.75rem, 7vw, 2.25rem);
      letter-spacing: 0;
      line-height: 1.15;
    }
    .nav ul a::after {
      bottom: -4px;
    }
    .nav :global(.nav-cta) {
      padding: 0.9rem 1.5rem;
      font-size: 1rem;
    }
  }
</style>
