---
import ImageSlot from './ImageSlot.astro';
import { HOME_MEDIA } from '../config';
---

<div class="rotator" data-rotator>
  {
    HOME_MEDIA.map((m, i) => (
      <div class:list={['frame', { active: i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
        <ImageSlot label={m.alt} type={m.type} src={m.src} ratio="auto" reveal={false} />
      </div>
    ))
  }
  <div class="dots" role="tablist" aria-label="Choose slide">
    {
      HOME_MEDIA.map((_, i) => (
        <button
          role="tab"
          aria-label={`Show slide ${i + 1}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          data-index={i}
        />
      ))
    }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-rotator]').forEach((root) => {
    const frames = [...root.querySelectorAll<HTMLElement>('.frame')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.dots button')];
    if (frames.length < 2) return;
    let current = 0;
    let timer: number | undefined;

    const show = (n: number) => {
      frames[current].classList.remove('active');
      frames[current].setAttribute('aria-hidden', 'true');
      dots[current].setAttribute('aria-selected', 'false');
      current = (n + frames.length) % frames.length;
      frames[current].classList.add('active');
      frames[current].removeAttribute('aria-hidden');
      dots[current].setAttribute('aria-selected', 'true');
    };

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const start = () => {
      if (reduced) return;
      stop();
      timer = window.setInterval(() => show(current + 1), 8000);
    };
    const stop = () => window.clearInterval(timer);

    dots.forEach((d) =>
      d.addEventListener('click', () => {
        show(Number(d.dataset.index));
        start();
      }),
    );
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    start();
  });
</script>

<style>
  /* Fills its positioned parent (the home hero) */
  .rotator {
    position: absolute;
    inset: 0;
  }
  .frame {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 2s var(--ease);
  }
  .frame.active {
    opacity: 1;
  }
  .frame :global(.slot) {
    height: 100%;
    border-radius: 0;
  }
  /* Placeholder in the hero: plain black with the shot label tucked under the header, top right */
  .frame :global(.empty) {
    align-items: flex-end;
    padding: calc(var(--header-h) + 1.5rem) var(--pad);
    background: var(--black);
  }
  .frame :global(.empty .what) {
    display: none;
  }
  .frame :global(.corner) {
    display: none;
  }
  .dots {
    position: absolute;
    right: max(var(--pad), calc((100% - var(--max)) / 2 + var(--pad)));
    top: calc(var(--header-h) + 3.5rem);
    display: flex;
    gap: 0.4rem;
    z-index: 3;
  }
  .dots button {
    width: 2.25rem;
    height: 2px;
    padding: 0;
    border: 0;
    background: rgba(255, 255, 255, 0.3);
    cursor: pointer;
    transition: background 0.3s;
  }
  .dots button::before {
    content: '';
    display: block;
    margin: -10px 0;
    height: 22px;
  }
  .dots button[aria-selected='true'] {
    background: var(--accent);
  }
</style>
