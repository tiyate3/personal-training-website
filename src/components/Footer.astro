---
import { BRAND, BASE_GYM, NAV } from '../config';
import SocialLinks from './SocialLinks.astro';
import logoWhite from '../assets/mustafatheathlete-logo-white.svg';
import { withBase } from '../utils/paths';

const year = new Date().getFullYear();
---

<footer class="footer on-dark">
  <div class="container inner">
    <div class="brand">
      <a class="logo" href={withBase('/')} aria-label={`${BRAND} home`}>
        <img src={logoWhite.src} width="550" height="200" alt="" />
      </a>
      <p>Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
      <SocialLinks />
    </div>

    <div>
      <p class="heading">Pages</p>
      <nav aria-label="Footer">
        <ul>
          {NAV.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div>
      <p class="heading">Where</p>
      <ul class="where">
        <li>{BASE_GYM}, London</li>
        <li>Home visits across London</li>
      </ul>
    </div>
  </div>
  <div class="container legal">
    <p>&copy; {year} {BRAND}</p>
  </div>
</footer>

<style>
  .footer {
    padding-top: clamp(3rem, 8vw, 5rem);
  }
  .inner {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 760px) {
    .inner {
      grid-template-columns: 1.6fr 1fr 1fr;
    }
  }
  .logo {
    display: inline-block;
    margin-left: -0.75rem;
  }
  .logo img {
    height: 76px;
    width: auto;
  }
  .brand p {
    margin: 0.25rem 0 1.25rem;
    max-width: 22rem;
    font-size: 0.95rem;
  }
  .heading {
    font-family: var(--font-nav);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: 1rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  ul a {
    text-decoration: none;
    color: var(--muted);
    font-size: 0.95rem;
  }
  ul a:hover {
    color: var(--text);
  }
  .where li {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .legal {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-block: 1.5rem 6rem;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 760px) {
    .legal {
      padding-bottom: 1.5rem;
    }
  }
  .legal p {
    margin: 0;
    font-size: 0.8rem;
  }
</style>
