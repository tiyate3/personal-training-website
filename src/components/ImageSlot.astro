---
/**
 * A space for one of Mustafa's own photos or videos.
 * Pass `src` once the file exists in /public/media to show it instead of the placeholder.
 * Until then the placeholder shows only what belongs there, centred.
 */
import { withBase } from '../utils/paths';

interface Props {
  label: string;
  ratio?: string;
  src?: string;
  type?: 'image' | 'video';
  class?: string;
  /** Wipe the image in when it scrolls into view. */
  reveal?: boolean;
  /** Reveal stagger step (0, 1, 2…). */
  delay?: number;
}

const {
  label,
  ratio = '4 / 5',
  src,
  type = 'image',
  class: className = '',
  reveal = true,
  delay = 0,
} = Astro.props;
const mediaSrc = src?.startsWith('/') ? withBase(src) : src;
---

<figure
  class:list={['slot', className]}
  style={`aspect-ratio: ${ratio}; --d: ${delay}`}
  data-reveal={reveal ? 'image' : undefined}
>
  {
    mediaSrc ? (
      type === 'video' ? (
        <video src={mediaSrc} autoplay muted loop playsinline aria-label={label} />
      ) : (
        <img src={mediaSrc} alt={label} loading="lazy" decoding="async" />
      )
    ) : (
      <div class="empty" role="img" aria-label={`Placeholder: ${label}`}>
        <span class="what">{label}</span>
      </div>
    )
  }
</figure>

<style>
  .slot {
    position: relative;
    margin: 0;
    width: 100%;
    overflow: hidden;
    background: var(--surface-2);
  }
  img,
  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Placeholder: just what belongs here, centred */
  .empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 2.2vw, 1.5rem);
    background: var(--surface-2);
    color: var(--muted);
    text-align: center;
  }
  .what {
    max-width: 22rem;
    font-family: var(--font-nav);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }
</style>
