---
/**
 * An empty, clearly marked space for one of Mustafa's own photos or videos.
 * Pass `src` once the file exists in /public/media to show it instead.
 */
interface Props {
  label: string;
  ratio?: string;
  src?: string;
  type?: 'image' | 'video';
  class?: string;
}
const { label, ratio = '4 / 5', src, type = 'image', class: className = '' } = Astro.props;
---

<figure class:list={['slot', className]} style={`aspect-ratio: ${ratio}`}>
  {
    src ? (
      type === 'video' ? (
        <video src={src} autoplay muted loop playsinline aria-label={label} />
      ) : (
        <img src={src} alt={label} loading="lazy" decoding="async" />
      )
    ) : (
      <div class="empty" role="img" aria-label={`Placeholder: ${label}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          {type === 'video' ? (
            <>
              <rect x="2.5" y="5" width="14" height="14" rx="2" />
              <path d="m16.5 10 5-3v10l-5-3" />
            </>
          ) : (
            <>
              <rect x="3" y="3" width="18" height="18" rx="2" />
              <circle cx="8.5" cy="8.5" r="1.8" />
              <path d="m21 15-5-5L5 21" />
            </>
          )}
        </svg>
        <span>{label}</span>
      </div>
    )
  }
</figure>

<style>
  .slot {
    position: relative;
    margin: 0;
    width: 100%;
    overflow: hidden;
    border-radius: 4px;
    background: var(--charcoal-2);
  }
  img,
  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.5rem;
    text-align: center;
    color: #5d605b;
    border: 1px dashed #2c2f33;
    border-radius: inherit;
    background:
      linear-gradient(135deg, rgba(57, 255, 20, 0.04), transparent 50%),
      var(--charcoal-2);
  }
  .empty svg {
    width: 2.25rem;
    height: 2.25rem;
  }
  .empty span {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
</style>
